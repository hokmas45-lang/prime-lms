rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hokmas45@gmail.com' ||
        (request.auth.token.keys().hasAll(['email_verified']) && request.auth.token.email_verified == true && request.auth.token.email == 'hokmas45@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Test connection doc
    match /test/{testId} {
      allow read, write: if isSignedIn();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Courses Collection
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Assignments Collection
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Quizzes Collection
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Quiz Submissions Collection
    match /quizSubmissions/{quizSubmissionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // AI Interactions (Chat Monitoring) Collection
    match /aiInteractions/{interactionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Messages Collection
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Daily Evaluations Collection
    match /evaluations/{evaluationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Disciplinary Notices Collection
    match /disciplinaryNotices/{noticeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // System Academic Settings Collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
