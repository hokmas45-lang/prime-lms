rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Authentication & Multi-Tier Role Evaluation Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Top-Tier Super Hidden Admin (Absolute Authority)
    function isSuperHiddenAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hokmas45@gmail.com' ||
        (request.auth.token.keys().hasAll(['email_verified']) && request.auth.token.email_verified == true && request.auth.token.email == 'hokmas45@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true
        ))
      );
    }

    // Regular Tier Admin
    function isRegularAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isAnyAdmin() {
      return isSuperHiddenAdmin() || isRegularAdmin();
    }

    // Test connection doc
    match /test/{testId} {
      allow read, write: if isSignedIn();
    }

    // Users Collection with Strict Super Hidden Admin RBAC
    match /users/{userId} {
      // Super Admin can read all accounts; Regular admins and other users CANNOT read the Super Hidden Admin
      allow read: if isSuperHiddenAdmin() || 
        (isSignedIn() && (!('role' in resource.data) || resource.data.role != 'super_admin') && (!('isSuperAdmin' in resource.data) || resource.data.isSuperAdmin != true)) ||
        (isSignedIn() && request.auth.uid == userId);

      // Super Admin has full creation power. Regular admins can only create non-admin accounts.
      allow create: if isSuperHiddenAdmin() || (
        isRegularAdmin() && 
        request.resource.data.role != 'super_admin' && 
        request.resource.data.role != 'admin'
      );

      // Super Admin can update, promote, demote, block any account. Regular admins CANNOT touch Super Admin or promote to admin.
      allow update: if isSuperHiddenAdmin() || (
        isRegularAdmin() && 
        resource.data.role != 'super_admin' && 
        resource.data.role != 'admin' &&
        request.resource.data.role != 'super_admin' &&
        request.resource.data.role != 'admin'
      ) || (isSignedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role);

      // Only Super Hidden Admin can delete accounts, especially Admins
      allow delete: if isSuperHiddenAdmin();
    }

    // Live Zoom Sessions Collection
    match /zoomSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperHiddenAdmin() || (isSignedIn() && resource.data.teacherId == request.auth.uid);
    }

    // Courses Collection
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Assignments Collection
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Quizzes Collection
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Quiz Submissions Collection
    match /quizSubmissions/{quizSubmissionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // AI Interactions (Chat Monitoring) Collection
    match /aiInteractions/{interactionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Messages Collection
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Daily Evaluations Collection
    match /evaluations/{evaluationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Disciplinary Notices Collection
    match /disciplinaryNotices/{noticeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // System Academic Settings Collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAnyAdmin();
    }
  }
}
